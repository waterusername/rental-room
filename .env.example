# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real passwords or API keys.

# First administrator. Created on the first sign-in when this email does not exist yet.
# Password must be at least 10 characters. Changing these later does not reset an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production database. Create a free Turso database and paste both values.
# https://turso.tech
# Development can leave these empty: the app uses data/auth.local.db instead.
# DATABASE_URL is an optional alias for TURSO_DATABASE_URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATABASE_URL=

# Stripe is optional. If STRIPE_SECRET_KEY or STRIPE_PRICE_ID is empty, payment
# gates are off and every active account can browse.
# Outside brokers pay $100 USD per month. Create that recurring Price in the
# Stripe Dashboard and paste its ID here. The app sends the Price ID only and
# does not set a dollar amount. STRIPE_PRICE_ID must be $100 USD, billed monthly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public site origin, no trailing slash. Used for Stripe return URLs.
NEXT_PUBLIC_APP_URL=https://rental-room-tau.vercel.app
